{
    "$schema": "https://turbo.build/schema.json",
    "extends": [
        "//"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^@think-and-dev/cartesi-boardgame#build"
            ],
            "outputs": [
                "build/**"
            ]
        },
        "build-server": {
            "dependsOn": [
                "^@think-and-dev/cartesi-boardgame#build"
            ],
            "outputs": [
                "server-build/**"
            ]
        },
        "dev": {
            "dependsOn": [
                "^@think-and-dev/cartesi-boardgame#build"
            ],
            "persistent": true
        },
        "start": {
            "dependsOn": [
                "build-server"
            ],
            "persistent": true
        }
    }
}